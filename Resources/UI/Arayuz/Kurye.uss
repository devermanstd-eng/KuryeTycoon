/* Kurye Şirketi Tycoon — UI Toolkit arayüz stili: koyu mürekkep / çizim (16.11 akşam; CityRT'nin çizim dilinden esinlenildi).
   Koyu kömür paneller, açık krem yazı, kalın siyah mürekkep çerçeve ve elle çizilmiş renkli simgeler: harita gündüz açık ve
   renkli olduğu için krem paneller haritada eriyordu, koyu paneller net ayrılıyor (önce krem kâğıt denendi, bkz. KURULUM.md).
   Renkler aşağıdaki değişkenlerde; koddan satır içi verilen renkler aynı paletten (U.cs: U.PanelRengi, U.YaziRengi, U.Iyi...).
   Şirket rengi (vurgu) koddan satır içi verilir; simgeler elle çizilmiş renkli PNG'ler (Resources/UI/Ikonlar, U.SimgeAyarla).
   Çerçeve: yüzen kutular (pencere, kart, bildirim, durum, üst çubuk kapsülleri) 2 px siyah mürekkep, altı 3 px (gölge yerine:
   UI Toolkit'te gölge yok); iç kartlar ve düğmeler 1,5 px, altı 2,5 px. Köşeler: kutu 16, kart 12, düğme 10, çip tam yuvarlak.
   Yazı hiyerarşisi: başlık 19–20 kalın · sayı 17–18 kalın · etiket 10–11 seyrek harfli · gövde 13.
   Boyutlar GUI birimi: ekran yüksekliği 900 px'e göre ölçeklenir (PanelSettings.scale = GameUI.uiScale). */

:root {
    --zemin: rgb(30, 27, 25);
    --zemin-koyu: rgb(20, 18, 16);
    --zemin-ust: rgba(0, 0, 0, 0);
    --yuzen: rgba(30, 27, 25, 0.96);
    --kart: rgb(43, 39, 36);
    --kart-ust: rgb(54, 49, 45);
    --kagit-acik: rgb(37, 33, 31);
    --dugme: rgb(50, 45, 41);
    --dugme-ust: rgb(62, 56, 51);
    --cerceve: rgb(8, 7, 6);
    --cizgi: rgba(255, 240, 222, 0.1);
    --kenar: rgba(8, 7, 6, 0.9);
    --kenar-ust: rgba(8, 7, 6, 0.9);
    --taban: rgb(8, 7, 6);
    --cukur: rgba(0, 0, 0, 0.28);
    --yazi: rgb(245, 238, 226);
    --soluk: rgb(178, 166, 152);
    --etiket: rgb(200, 180, 154);
    --iyi: rgb(132, 204, 118);
    --kotu: rgb(238, 110, 88);
    --uyari: rgb(245, 165, 80);
    --sari: rgb(242, 196, 84);
}

/* ---------------------------------------------------------------- temel */

.kok {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--yazi);
    font-size: 13px;
}

.katman {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Etiketlerin varsayılan boşluğu sıfır. Tek sınıflı seçici: aşağıdaki .cip, .hap-yazi, .ipucu, .pencere-baslik gibi
   kurallar kendi boşluklarını verebilsin (".kok .unity-label" iki sınıflıydı ve hepsini eziyordu). Temanın kuralını da
   yener: bu stil kök elemana eklendiği için aynı güçteki seçicide sonra gelir. */
.unity-label {
    margin: 0;
    padding: 0;
}

.yazi { color: var(--yazi); font-size: 13px; white-space: normal; }
.soluk { color: var(--soluk); }
.kucuk { font-size: 12px; }
.minik { font-size: 11px; }
.buyuk { font-size: 15px; }
.iyi { color: var(--iyi); }
.kotu { color: var(--kotu); }
.uyari-renk { color: var(--uyari); }
.tek-satir { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.satir { flex-direction: row; align-items: center; }
.kolon { flex-direction: column; }
.esnek { flex-grow: 1; flex-shrink: 1; }
.bosluk { flex-grow: 1; }
.sag-yasli { -unity-text-align: middle-right; }

.bolum {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    margin-bottom: 6px;
}
.bolum-yazi {
    font-size: 11px;
    color: var(--etiket);
    -unity-font-style: bold;
    letter-spacing: 0.9px;
}
.bolum-cizgi {
    flex-grow: 1;
    height: 1px;
    margin-left: 8px;
    background-color: var(--cizgi);
}

.kart {
    background-color: var(--kart);
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--kenar);
    padding: 10px 14px 10px 14px;
    margin-bottom: 8px;
    border-bottom-width: 2.5px;
}

.satir-kart {
    flex-direction: row;
    align-items: center;
    background-color: var(--kart);
    border-radius: 10px;
    border-width: 1.5px;
    border-color: var(--kenar);
    padding: 7px 10px 7px 12px;
    margin-bottom: 5px;
    min-height: 40px;
    border-bottom-width: 2.5px;
}
.satir-kart:hover { background-color: var(--kart-ust); }
.satir-kart.acik { background-color: var(--kart-ust); border-bottom-left-radius: 0; border-bottom-right-radius: 0; margin-bottom: 0; }

.ayrinti {
    background-color: var(--kagit-acik);
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-width: 0 1.5px 2.5px 1.5px;
    border-color: var(--kenar);
    padding: 10px 14px 12px 14px;
    margin-bottom: 6px;
}

.bilgi-kutusu {
    background-color: rgba(255, 240, 222, 0.045);
    border-radius: 10px;
    border-width: 1.5px;
    border-color: var(--kenar);
    padding: 9px 12px 9px 12px;
    margin-bottom: 8px;
}

/* ---------------------------------------------------------------- düğmeler */

Button.dg {
    background-color: var(--dugme);
    border-width: 1.5px;
    border-color: var(--cerceve);
    border-radius: 10px;
    margin: 0 0 0 6px;
    padding: 0 13px 0 13px;
    height: 30px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--yazi);
    -unity-text-align: middle-center;
    transition-property: background-color, scale;
    transition-duration: 0.08s;
    border-bottom-width: 2.5px;
}
Button.dg:hover { background-color: var(--dugme-ust); }
Button.dg:active { scale: 0.97 0.97; }
Button.dg:disabled { opacity: 0.4; }
Button.dg.ilk { margin-left: 0; }
Button.dg.kucuk-dg { height: 26px; padding: 0 10px 0 10px; font-size: 11px; border-radius: 9px; }
Button.dg.genis { flex-grow: 1; }
Button.dg.tehlike { background-color: rgba(238, 110, 88, 0.16); color: var(--kotu); border-color: var(--kotu); }
Button.dg.tehlike:hover { background-color: rgba(238, 110, 88, 0.28); }

.simge-dugme {
    width: 30px;
    height: 30px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
}
.simge-dugme:hover { background-color: var(--kart-ust); }

/* Seçenek (radyo) şeridi */
.secenekler {
    flex-direction: row;
    background-color: var(--cukur);
    border-radius: 11px;
    border-width: 1.5px;
    border-color: var(--kenar);
    padding: 3px;
}
.secenek {
    flex-grow: 1;
    flex-basis: 0;
    height: 27px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: var(--soluk);
    -unity-text-align: middle-center;
}
.secenek:hover { background-color: rgba(255, 240, 222, 0.07); color: var(--yazi); }
.secenek.secili { color: var(--yazi); -unity-font-style: bold; }

/* Onay kutusu (toggle) */
.onay {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}
.onay-kutu {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(255, 240, 222, 0.45);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.onay:hover .onay-kutu { border-color: var(--cerceve); }
.onay-isaret { width: 12px; height: 12px; }
.onay-yazi { margin-left: 9px; flex-shrink: 1; white-space: normal; }

/* ---------------------------------------------------------------- çip, çubuk, seviye */

.cipler { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.cip {
    height: 22px;
    border-radius: 11px;
    padding: 0 10px 0 10px;
    margin: 0 5px 4px 0;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.2px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    border-width: 1.5px;
    border-color: rgba(255, 240, 222, 0.45);
}

.cubuk {
    height: 7px;
    border-radius: 4px;
    background-color: var(--cukur);
    border-width: 1px;
    border-color: rgba(255, 240, 222, 0.25);
    overflow: hidden;
    flex-grow: 1;
}
.cubuk-dolu { height: 100%; border-radius: 3px; }

.seviyeler { flex-direction: row; align-items: center; }
.seviye {
    width: 18px;
    height: 6px;
    border-radius: 3px;
    margin-right: 3px;
    background-color: rgba(255, 240, 222, 0.13);
}

.rozet {
    position: absolute;
    top: 3px;
    right: 3px;
    min-width: 20px;
    height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: var(--zemin);
    padding: 0 5px 0 5px;
    background-color: var(--kotu);
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.yeni-nokta {
    position: absolute;
    top: 6px;
    right: 8px;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: var(--sari);
    border-width: 1.5px;
    border-color: var(--cerceve);
}

/* ---------------------------------------------------------------- üst çubuk */

.ust {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 60px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-bottom-width: 0;
}
.marka {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 0 5px 0 5px;
    border-radius: 16px;
    background-color: var(--zemin);
    border-width: 2px;
    border-color: var(--cerceve);
    border-bottom-width: 3px;
    flex-shrink: 0;
}
.logo {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    border-width: 2px;
    border-color: var(--cerceve);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.logo-harf { font-size: 19px; -unity-text-align: middle-center; }
.sirket-adi {
    font-size: 17px;
    margin-left: 10px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-right: 9px;
}
.ust-gostergeler {
    flex-direction: row;
    align-items: center;
    margin-left: 10px;
    flex-shrink: 0;
    height: 48px;
    padding: 0 4px 0 4px;
    border-radius: 16px;
    background-color: var(--zemin);
    border-width: 2px;
    border-color: var(--cerceve);
    border-bottom-width: 3px;
}
.gosterge {
    flex-direction: row;
    align-items: center;
    height: 40px;
    padding: 0 12px 0 6px;
    margin-right: 2px;
    border-radius: 11px;
    flex-shrink: 0;
}
.gosterge:hover { background-color: rgba(255, 240, 222, 0.07); }
.gosterge-simge-kutu {
    width: 30px;
    height: 30px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-width: 1.5px;
    border-color: var(--cerceve);
}
.gosterge-simge { width: 20px; height: 20px; }
.gosterge-yazi { margin-left: 9px; }
.gosterge-deger { font-size: 18px; -unity-font-style: bold; white-space: nowrap; }
.gosterge-alt { font-size: 10px; color: var(--soluk); letter-spacing: 0.4px; white-space: nowrap; margin-top: -1px; }
.gosterge.zaman {
    margin-right: 0;
    height: 48px;
    padding: 0 14px 0 6px;
    border-radius: 16px;
    background-color: var(--zemin);
    border-width: 2px;
    border-color: var(--cerceve);
    border-bottom-width: 3px;
    margin-left: 10px;
}
.hiz {
    flex-direction: row;
    align-items: center;
    height: 48px;
    padding: 4px;
    border-radius: 16px;
    background-color: var(--zemin);
    border-width: 2px;
    border-color: var(--cerceve);
    flex-shrink: 0;
    margin-left: 10px;
    border-bottom-width: 3px;
}
.hiz-oynat {
    width: 46px;
    height: 34px;
    border-radius: 11px;
    align-items: center;
    justify-content: center;
    background-color: var(--dugme);
    border-width: 1.5px;
    border-color: var(--cerceve);
    margin-right: 6px;
    border-bottom-width: 2.5px;
}
.hiz-oynat:hover { background-color: var(--dugme-ust); }
.hiz-dilim {
    width: 38px;
    height: 34px;
    border-radius: 10px;
    margin-left: 2px;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--soluk);
    -unity-text-align: middle-center;
}
.hiz-dilim:hover { background-color: rgba(255, 240, 222, 0.08); }

/* ---------------------------------------------------------------- sol menü */

.dock {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 76px;
    padding-top: 70px;
    padding-bottom: 10px;
    background-color: var(--zemin-koyu);
    border-right-width: 2px;
    border-color: var(--cerceve);
}
.dock-oge {
    margin: 0 7px 6px 7px;
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--cerceve);
    align-items: center;
    justify-content: center;
    background-color: var(--zemin);
    border-bottom-width: 3px;
}
.dock-oge:hover { background-color: var(--dugme-ust); }
.dock-simge { width: 26px; height: 26px; }
.dock-yazi { font-size: 10px; margin-top: 3px; color: var(--soluk); letter-spacing: 0.2px; white-space: nowrap; }
.dock-oge:hover .dock-yazi { color: var(--yazi); }

/* ---------------------------------------------------------------- pencere */

.pencere {
    position: absolute;
    left: 86px;
    top: 70px;
    bottom: 56px;
}
.pencere-ust {
    background-color: var(--zemin);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-width: 2px 2px 0 2px;
    border-color: var(--cerceve);
    padding: 0 14px 0 14px;
}
.pencere-baslik-satir { flex-direction: row; align-items: center; height: 54px; }
.pencere-simge-kutu {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border-width: 1.5px;
    border-color: var(--cerceve);
    align-items: center;
    justify-content: center;
    margin-left: 2px;
}
.pencere-baslik { font-size: 20px; -unity-font-style: bold; margin-left: 11px; flex-grow: 1; }
.sekmeler {
    flex-direction: row;
    height: 36px;
    border-radius: 12px;
    background-color: var(--cukur);
    border-width: 1.5px;
    border-color: var(--kenar);
    padding: 3px;
    margin-bottom: 10px;
}
.sekme {
    flex-grow: 1;
    flex-basis: 0;
    border-radius: 9px;
    font-size: 13px;
    color: var(--soluk);
    -unity-text-align: middle-center;
    margin-right: 2px;
}
.sekme:hover { background-color: rgba(255, 240, 222, 0.07); color: var(--yazi); }
.sekme .yeni-nokta { top: 5px; right: 6px; width: 7px; height: 7px; }
.pencere-cizgi { height: 1px; background-color: var(--cizgi); }
.pencere-govde {
    flex-grow: 1;
    background-color: var(--zemin);
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-width: 0 2px 3px 2px;
    border-color: var(--cerceve);
    padding: 8px 6px 10px 14px;
}
.pencere-govde.imgui {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.sekme-ust { flex-shrink: 0; padding-right: 8px; }
.kaydir { flex-grow: 1; }
.kaydir .unity-scroll-view__content-container { padding-right: 8px; }
.kaydir .unity-scroller--vertical { width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.kaydir .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.kaydir .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 240, 222, 0.18);
    border-width: 0;
    border-radius: 4px;
}
.kaydir .unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: rgba(255, 240, 222, 0.32); }
.kaydir .unity-scroller__low-button,
.kaydir .unity-scroller__high-button { display: none; }
.kaydir .unity-scroll-view__horizontal-scroller { display: none; }

/* ---------------------------------------------------------------- harita araçları */

.harita-arac {
    position: absolute;
    bottom: 10px;
    flex-direction: row;
    align-items: center;
}
.arac-grup {
    flex-direction: row;
    align-items: center;
    background-color: var(--yuzen);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--cerceve);
    padding: 3px;
    margin-right: 6px;
    border-bottom-width: 3px;
}
.arac {
    height: 30px;
    min-width: 32px;
    border-radius: 9px;
    align-items: center;
    justify-content: center;
    padding: 0 8px 0 8px;
    flex-direction: row;
}
.arac:hover { background-color: rgba(255, 240, 222, 0.1); }
.arac-simge { width: 16px; height: 16px; }
.arac-yazi { font-size: 12px; color: var(--yazi); white-space: nowrap; }
.arac-yazi.simgeli { margin-left: 6px; }
.katman-menu {
    position: absolute;
    bottom: 48px;
    width: 236px;
    background-color: var(--zemin);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--cerceve);
    padding: 6px;
    border-bottom-width: 3px;
}
.katman-oge {
    height: 42px;
    border-radius: 9px;
    padding: 4px 10px 4px 10px;
    justify-content: center;
}
.katman-oge:hover { background-color: rgba(255, 240, 222, 0.07); }
.katman-ad { font-size: 13px; -unity-font-style: bold; }
.katman-aciklama { font-size: 11px; color: var(--soluk); margin-top: 1px; }
.katman-not {
    background-color: var(--yuzen);
    border-width: 2px;
    border-color: var(--cerceve);
    border-radius: 12px;
    padding: 5px 12px 5px 12px;
    font-size: 12px;
    color: var(--yazi);
    max-width: 600px;
    white-space: normal;
    border-bottom-width: 2px;
}

/* ---------------------------------------------------------------- olaylar kartı (Dikkat + akış) */

.olaylar {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 470px;
    background-color: var(--yuzen);
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--cerceve);
    padding: 8px 10px 10px 10px;
    border-bottom-width: 3px;
}
.olaylar-baslik { flex-direction: row; align-items: center; height: 28px; padding: 0 4px 0 4px; }
.olaylar-baslik:hover { background-color: rgba(255, 240, 222, 0.05); border-radius: 8px; }
.olay-oge {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    border-radius: 8px;
    padding: 2px 6px 2px 6px;
}
.olay-oge.tiklanir:hover { background-color: rgba(255, 240, 222, 0.08); }
.olay-nokta { width: 7px; height: 7px; border-radius: 4px; flex-shrink: 0; }
.olay-yazi { margin-left: 8px; font-size: 12px; flex-shrink: 1; white-space: normal; }
.olay-git { width: 12px; height: 12px; margin-left: 6px; opacity: 0.8; flex-shrink: 0; }
.olaylar-ayrac { height: 1px; background-color: var(--cizgi); margin: 4px 4px 4px 4px; }

/* ---------------------------------------------------------------- hedef kutusu, ipucu */

.hedef-kutu {
    position: absolute;
    top: 70px;
    width: 330px;
    background-color: var(--yuzen);
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--cerceve);
    padding: 10px 12px 10px 12px;
    border-bottom-width: 3px;
}
.hedef-kutu:hover { background-color: var(--dugme-ust); }
.hedef-satir { flex-direction: row; align-items: center; margin-top: 4px; }
.hedef-daire {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: rgba(255, 240, 222, 0.45);
    flex-shrink: 0;
}
.hedef-ad { margin-left: 8px; font-size: 12px; flex-grow: 1; flex-shrink: 1; }
.hedef-sayi { font-size: 12px; color: var(--soluk); margin-left: 6px; }

.ipucu {
    position: absolute;
    max-width: 320px;
    background-color: var(--cerceve);
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--cerceve);
    padding: 8px 11px 8px 11px;
    font-size: 12px;
    color: var(--yazi);
    white-space: normal;
    border-bottom-width: 2px;
}

/* ---------------------------------------------------------------- sipariş satırı */

.sure {
    width: 46px;
    height: 22px;
    border-radius: 11px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    border-width: 1.5px;
    border-color: rgba(255, 240, 222, 0.45);
}
.siparis-ana { flex-grow: 1; flex-shrink: 1; margin-left: 10px; }
.siparis-ad { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.siparis-alt { font-size: 11px; color: var(--soluk); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }
.tutar { font-size: 13px; -unity-font-style: bold; color: var(--iyi); margin-left: 8px; -unity-text-align: middle-right; white-space: nowrap; }
.mini-simge { width: 14px; height: 14px; margin-right: 4px; flex-shrink: 0; }

/* ---------------------------------------------------------------- kurye kartı */

.portre {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--cerceve);
    background-color: rgba(255, 240, 222, 0.06);
    flex-shrink: 0;
}
.yildiz {
    position: absolute;
    right: -4px;
    bottom: -4px;
    height: 17px;
    border-radius: 9px;
    border-width: 1.5px;
    border-color: var(--cerceve);
    padding: 0 5px 0 5px;
    background-color: rgb(58, 50, 34);
    color: var(--sari);
    font-size: 10px;
    -unity-text-align: middle-center;
}
.kurye-ana { flex-grow: 1; flex-shrink: 1; margin-left: 12px; }
.olcu { flex-direction: row; align-items: center; margin-top: 4px; }
.olcu-ad { width: 72px; font-size: 11px; color: var(--etiket); }
.olcu-deger { width: 40px; font-size: 11px; -unity-text-align: middle-right; }

/* ---------------------------------------------------------------- geliştirme kartı */

.gelisim-simge {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--cerceve);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.gelisim-ana { flex-grow: 1; flex-shrink: 1; margin-left: 12px; }
.kilit-yazi { font-size: 11px; color: var(--uyari); margin-top: 4px; white-space: normal; }

/* ---------------------------------------------------------------- ortadaki kutular: olay kartı, Esc menüsü, onay */

.perde {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 7, 6, 0.6);
    align-items: center;
    justify-content: center;
}
.modal-kart {
    background-color: var(--zemin);
    border-radius: 20px;
    border-width: 2px;
    border-color: var(--cerceve);
    border-bottom-width: 3px;
    overflow: hidden;
    flex-shrink: 1;
}
.modal-baslik { font-size: 24px; -unity-font-style: bold; margin-bottom: 4px; }
Button.dg.modal-dg { height: 36px; margin: 6px 0 0 0; font-size: 14px; border-radius: 11px; }
.satir > Button.dg.modal-dg { margin: 0 0 0 6px; }
.satir > Button.dg.modal-dg.ilk { margin-left: 0; }

.olay-ust {
    flex-direction: row;
    align-items: center;
    min-height: 56px;
    padding: 10px 24px 10px 24px;
    flex-shrink: 0;
}
.olay-serit { width: 6px; height: 22px; border-radius: 3px; flex-shrink: 0; }
.olay-baslik { font-size: 21px; -unity-font-style: bold; margin-left: 12px; flex-shrink: 1; white-space: normal; }
.olay-icerik { padding: 16px 24px 20px 24px; flex-shrink: 1; min-height: 0; }
.ozet-satir { flex-direction: row; margin-bottom: 14px; flex-shrink: 0; }
.ozet-kutu {
    flex-grow: 1;
    flex-basis: 0;
    height: 64px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--kenar);
    margin-left: 8px;
    align-items: center;
    justify-content: center;
}
.ozet-kutu.ilk { margin-left: 0; }
.ozet-baslik { font-size: 10px; color: var(--etiket); letter-spacing: 0.8px; -unity-text-align: middle-center; white-space: nowrap; }
.ozet-deger { font-size: 18px; -unity-font-style: bold; margin-top: 4px; -unity-text-align: middle-center; white-space: nowrap; }
.olay-govde { flex-grow: 0; flex-shrink: 1; min-height: 40px; }
.olay-metin { font-size: 14px; white-space: normal; }
Button.dg.olay-ayrinti { margin: 8px 0 0 0; }
.olay-secenekler { margin-top: 16px; flex-shrink: 0; }
Button.dg.olay-secim {
    height: auto;
    min-height: 40px;
    margin: 0 0 7px 0;
    padding: 7px 15px 7px 15px;
    border-radius: 11px;
    font-size: 14px;
    white-space: normal;
}

.menu-kart { width: 440px; padding: 18px 20px 20px 20px; }
.onay-kart { width: 440px; padding: 18px 20px 20px 20px; }
.onay-baslik { font-size: 18px; -unity-font-style: bold; margin-bottom: 6px; }
.onay-metin { font-size: 14px; white-space: normal; }

/* ---------------------------------------------------------------- bildirimler */

.bildirimler {
    position: absolute;
    top: 72px;
}
.bildirim {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    margin-bottom: 8px;
    background-color: var(--zemin);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--cerceve);
    overflow: hidden;
    padding-right: 12px;
    border-bottom-width: 3px;
}
.bildirim-serit { width: 5px; align-self: stretch; flex-shrink: 0; }
.bildirim-simge-kutu {
    width: 32px;
    height: 32px;
    border-radius: 16px;
    margin-left: 11px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-width: 1.5px;
    border-color: var(--cerceve);
}
.bildirim-yazi { flex-grow: 1; flex-shrink: 1; margin-left: 12px; padding: 6px 0 7px 0; }
.bildirim-metin { font-size: 13px; white-space: normal; margin-top: 1px; }

/* ---------------------------------------------------------------- ilk gün rehberi */

.rehber-kart {
    position: absolute;
    width: 390px;
    background-color: var(--zemin);
    border-radius: 16px;
    border-width: 2.5px;
    border-color: rgb(196, 146, 30);
    border-bottom-width: 3.5px;
    padding: 14px 16px 14px 16px;
}
.rehber-baslik { font-size: 16px; -unity-font-style: bold; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.rehber-metin { font-size: 14px; margin-top: 6px; white-space: normal; }
.rehber-vurgu {
    position: absolute;
    border-width: 2.5px;
    border-radius: 15px;
}
.rehber-tikla {
    position: absolute;
    width: 64px;
    height: 26px;
    border-radius: 13px;
    align-items: center;
    justify-content: center;
}
.rehber-tikla-yazi { font-size: 12px; color: rgb(26, 26, 31); }

/* ---------------------------------------------------------------- yazıcı (UiYazici.cs: metin ağırlıklı pencereler) */

.yz-satir { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.yz-metin { flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: 13px; }
.yz-metin.kucuk { font-size: 12px; }
.yz-baslik { font-size: 15px; -unity-font-style: bold; margin-bottom: 3px; }
.not-renk { color: rgb(214, 200, 176); }
.yz-nokta { width: 9px; height: 9px; border-radius: 3px; margin: 4px 8px 0 0; flex-shrink: 0; }
.yz-kv { flex-direction: row; align-items: center; min-height: 24px; margin-bottom: 1px; border-bottom-width: 1px; border-color: rgba(255, 240, 222, 0.1); }
.yz-kv-ad { flex-grow: 1; flex-shrink: 1; font-size: 13px; color: var(--soluk); white-space: normal; }
.yz-kv-deger { font-size: 13px; margin-left: 10px; -unity-text-align: middle-right; white-space: nowrap; }
.yardim-rozet {
    width: 17px;
    height: 17px;
    border-radius: 9px;
    margin-left: 6px;
    flex-shrink: 0;
    background-color: rgba(255, 240, 222, 0.1);
    font-size: 11px;
    color: var(--soluk);
    -unity-text-align: middle-center;
    border-width: 1.5px;
    border-color: rgba(255, 240, 222, 0.45);
}
.yardim-rozet:hover { background-color: rgba(255, 240, 222, 0.2); color: var(--yazi); }
.bolum .yardim-rozet { margin-left: 8px; }
.yz-kart { margin-top: 4px; }
.yz-dugmeler { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 6px; }
.yz-dugmeler > .yz-satir { margin: 0 8px 6px 0; flex-grow: 0; }
Button.dg.yz-dugme {
    height: auto;
    min-height: 30px;
    margin: 4px 0 4px 0;
    padding: 5px 12px 5px 12px;
    font-size: 13px;
    white-space: normal;
}
Button.dg.yz-dugme.kucuk-dg { min-height: 26px; padding: 3px 10px 3px 10px; font-size: 12px; }
.yz-dugmeler > Button.dg.yz-dugme { margin: 0 6px 6px 0; }
.yz-cipler { flex-direction: row; flex-wrap: wrap; }
.yz-cip {
    height: 28px;
    border-radius: 14px;
    border-width: 1.5px;
    border-color: var(--kenar);
    padding: 0 12px 0 12px;
    margin: 0 6px 6px 0;
    font-size: 12px;
    -unity-text-align: middle-center;
}
.yz-acilir {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin: -4px -6px 2px -6px;
    padding: 4px 6px 4px 6px;
    border-radius: 8px;
}
.yz-acilir:hover { background-color: rgba(255, 240, 222, 0.05); }
.yz-acilir-ad { font-size: 15px; -unity-font-style: bold; flex-grow: 1; flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.yz-acilir-sag { font-size: 12px; margin-left: 8px; white-space: nowrap; }
.yz .olcu-deger { width: auto; min-width: 44px; margin-left: 8px; }

/* ---------------------------------------------------------------- durum sütunu (sağ üst: kredi, boost, kriz, etkinlik…) */

.durum {
    position: absolute;
    top: 70px;
    right: 12px;
    width: 300px;
    overflow: hidden;
}
.durum-kart {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    margin-bottom: 6px;
    padding-right: 10px;
    background-color: var(--yuzen);
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--cerceve);
    overflow: hidden;
    flex-shrink: 0;
    border-bottom-width: 3px;
}
.durum-kart:hover { background-color: var(--dugme-ust); }
.durum-serit { width: 4px; align-self: stretch; flex-shrink: 0; }
.durum-simge-kutu {
    width: 28px;
    height: 28px;
    border-radius: 9px;
    margin-left: 9px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-width: 1.5px;
    border-color: var(--cerceve);
}
.durum-yazi { flex-grow: 1; flex-shrink: 1; margin-left: 10px; padding: 6px 0 6px 0; }
.durum-baslik { font-size: 13px; -unity-font-style: bold; white-space: normal; }
.durum-alt { font-size: 11px; color: var(--soluk); white-space: normal; margin-top: 2px; }

/* ---------------------------------------------------------------- yazıcı: sayı kutuları, tablo, ayar kontrolleri */

.yz-kutular { flex-direction: row; flex-wrap: wrap; margin: 2px -6px 4px 0; }
.yz-kutu {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 100px;
    margin: 0 6px 6px 0;
    padding: 8px 11px 8px 11px;
    border-radius: 11px;
    border-width: 1.5px;
    border-color: var(--kenar);
    background-color: var(--kagit-acik);
    border-bottom-width: 2.5px;
}
.yz-kart .yz-kutu { background-color: var(--kagit-acik); }
.yz-kutu:hover { background-color: var(--dugme-ust); }
.yz-kutu-baslik { font-size: 10px; color: var(--etiket); letter-spacing: 0.8px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.yz-kutu-deger { font-size: 18px; -unity-font-style: bold; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.yz-kutu-alt { font-size: 11px; color: var(--soluk); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.yz-tablo-satir {
    flex-direction: row;
    align-items: center;
    min-height: 25px;
    border-bottom-width: 1px;
    border-color: rgba(255, 240, 222, 0.08);
}
.yz-tablo-satir:hover { background-color: rgba(255, 240, 222, 0.04); }
.yz-tablo-satir.baslik { min-height: 22px; border-color: rgba(255, 240, 222, 0.22); }
.yz-tablo-satir.baslik:hover { background-color: rgba(0, 0, 0, 0); }
.yz-tablo-satir .yz-nokta { margin: 0 8px 0 0; }
.yz-tablo-ilk { flex-grow: 1; flex-shrink: 1; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.yz-tablo-hucre { width: 66px; flex-shrink: 0; margin-left: 4px; font-size: 13px; -unity-text-align: middle-right; white-space: nowrap; }
.yz-tablo-satir.baslik .yz-tablo-ilk,
.yz-tablo-satir.baslik .yz-tablo-hucre { font-size: 10px; color: var(--etiket); letter-spacing: 0.8px; -unity-font-style: bold; }

.yz-kaydir { flex-direction: row; align-items: center; min-height: 28px; margin-bottom: 1px; }
.yz-kaydir-ad { width: 132px; flex-shrink: 0; font-size: 13px; color: var(--soluk); white-space: normal; }
.yz-kaydir-deger { min-width: 66px; margin-left: 8px; font-size: 13px; -unity-text-align: middle-right; white-space: nowrap; }
.yz-slider { flex-grow: 1; flex-shrink: 1; min-width: 60px; margin: 0; height: 22px; }
.yz-slider .unity-base-field__label { display: none; }
.yz-slider .unity-base-slider__input { min-width: 0; }
.yz-slider .unity-base-slider__drag-container { height: 22px; }
/* Temanın yatay kaydırıcı kurallarından güçlü olsun diye üç sınıflı seçici */
.yz-slider.unity-base-slider--horizontal .unity-base-slider__tracker {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 6px;
    margin-top: -3px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(255, 240, 222, 0.14);
}
.yz-slider.unity-base-slider--horizontal .unity-base-slider__dragger {
    position: absolute;
    top: 50%;
    width: 16px;
    height: 16px;
    margin-top: -8px;
    border-width: 2px;
    border-radius: 8px;
    background-color: var(--dugme);
    border-color: var(--cerceve);
}
.yz-slider.unity-base-slider--horizontal:hover .unity-base-slider__dragger { background-color: rgb(255, 255, 255); }
.yz .onay { margin-top: 2px; margin-bottom: 5px; }

/* ---------------------------------------------------------------- grafikler */

.grafik-kutu { margin-bottom: 10px; }
.grafik {
    height: 70px;
    margin: 3px 0 2px 0;
    border-radius: 8px;
    background-color: var(--cukur);
}
.grafik.cizgi { height: 56px; }
.saat-cizelgesi { margin: 8px 0 6px 0; }
.saat-serit { height: 22px; }
.saat-etiketler { flex-direction: row; justify-content: space-between; margin-top: 2px; }

/* ---------------------------------------------------------------- kurye ayrıntısı (sade) */

.beceri-izgara { flex-direction: row; flex-wrap: wrap; margin: 2px 0 4px 0; }
.beceri { flex-direction: row; align-items: center; width: 50%; min-height: 20px; }
.beceri-ad { width: 86px; font-size: 12px; color: var(--etiket); }
.kurye-bilgi { flex-direction: row; min-height: 20px; align-items: flex-start; }
.kurye-bilgi-ad { width: 72px; flex-shrink: 0; font-size: 12px; color: var(--etiket); }
.kurye-bilgi-deger { flex-grow: 1; flex-shrink: 1; font-size: 12px; white-space: normal; }

/* ---------------------------------------------------------------- kurye telefonu (Arayuz/UiTelefon.cs)
   Koyu mürekkep tema: siyah gövde, kömür ekran, açık yazı; şirket rengi koddan satır içi. */

.tel { position: absolute; }
.tel-golge {
    position: absolute;
    left: -2px;
    right: -2px;
    top: 8px;
    bottom: -8px;
    border-radius: 48px;
    background-color: rgba(0, 0, 0, 0.45);
}
.tel-tus { position: absolute; width: 4px; border-radius: 2px; background-color: var(--cerceve); }
.tel-govde {
    flex-grow: 1;
    border-radius: 46px;
    background-color: var(--cerceve);
    border-width: 2px;
    border-color: var(--cerceve);
    padding: 8px;
}
.tel-ekran { flex-grow: 1; border-radius: 37px; background-color: var(--zemin); overflow: hidden; }
.tel-sayfa { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tel-liste-sayfa { padding: 48px 16px 22px 16px; }
.tel-alt-sayfa { padding-left: 18px; padding-right: 18px; }
.tel-ust-satir { flex-shrink: 0; margin-bottom: 4px; }
.tel-sayfa-baslik { font-size: 26px; color: var(--yazi); margin: 4px 0 6px 0; white-space: normal; flex-shrink: 0; }
.tel-yuvarlak {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: var(--dugme);
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: var(--cerceve);
}
.tel-yuvarlak:hover { background-color: var(--kart); }
.tel-yuvarlak.kucuk { width: 36px; height: 36px; border-radius: 18px; }
.tel-harita-dg { position: absolute; top: 44px; }
.tel-zil-nokta {
    position: absolute;
    top: 46px;
    right: 65px;
    width: 9px;
    height: 9px;
    border-radius: 4.5px;
    background-color: rgb(214, 90, 70);
    border-width: 1.5px;
    border-color: var(--cerceve);
}

/* Harita */
.tel-harita { position: absolute; left: 0; top: 0; right: 0; overflow: hidden; }
.tel-poi { position: absolute; font-size: 9px; color: rgb(240, 206, 130); white-space: nowrap; text-shadow: 0px 1px 2px rgba(0, 0, 0, 0.9); }
.tel-semt {
    position: absolute;
    font-size: 10px;
    color: rgba(235, 222, 205, 0.42);
    white-space: nowrap;
    -unity-font-style: italic;
    translate: -50% -50%;
    letter-spacing: 1px;
}
.tel-sokak {
    position: absolute;
    font-size: 8px;
    color: rgba(225, 215, 200, 0.75);
    white-space: nowrap;
    text-shadow: 0px 0px 2px rgba(20, 18, 16, 1);
}
.tel-balon {
    position: absolute;
    flex-direction: row;
    align-items: center;
    height: 30px;
    border-radius: 15px;
    background-color: var(--dugme);
    padding: 0 14px 0 3px;
    border-width: 2px;
    border-color: var(--cerceve);
}
.tel-balon-nokta { width: 24px; height: 24px; border-radius: 12px; }
.tel-balon-yazi { font-size: 12px; color: var(--yazi); margin-left: 7px; white-space: nowrap; }
.tel-kurye {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-color: rgb(30, 27, 25);
}
.tel-kurye-harf { font-size: 11px; color: rgb(0, 0, 0); -unity-text-align: middle-center; }

/* Alt panel (ana ekran) */
.tel-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--kagit-acik);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding-top: 20px;
    border-top-width: 2px;
    border-color: var(--cerceve);
}
.tel-tutamak {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 48px;
    height: 4px;
    margin-left: -24px;
    border-radius: 2px;
    background-color: rgba(255, 240, 222, 0.22);
}
.tel-kaydir { flex-grow: 1; }
.tel-sheet > .tel-kaydir { margin-bottom: 10px; }
.tel .tel-kaydir .unity-scroll-view__content-container { padding-right: 0; }
.tel-sheet .tel-kaydir .unity-scroll-view__content-container { padding: 0 18px 0 18px; }

/* Durum çubuğu ve alt çizgi */
.tel-durum-cubugu { position: absolute; left: 0; top: 0; right: 0; height: 40px; }
.tel-saat { position: absolute; left: 28px; top: 10px; height: 22px; font-size: 13px; color: var(--yazi); -unity-text-align: middle-left; }
.tel-ada {
    position: absolute;
    left: 50%;
    margin-left: -48px;
    top: 9px;
    width: 96px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--cerceve);
}
.tel-sinyal { position: absolute; right: 56px; top: 13px; height: 12px; flex-direction: row; align-items: flex-end; }
.tel-sinyal-cubuk { width: 3px; margin-right: 2px; border-radius: 1px; background-color: var(--cerceve); }
.tel-pil {
    position: absolute;
    right: 24px;
    top: 15px;
    width: 24px;
    height: 12px;
    border-radius: 3.5px;
    background-color: rgba(255, 240, 222, 0.3);
    overflow: hidden;
}
.tel-pil-dolu { height: 100%; border-radius: 3.5px; }
.tel-pil-uc { position: absolute; right: 21px; top: 19px; width: 2px; height: 4px; border-radius: 1px; background-color: rgba(255, 240, 222, 0.45); }
.tel-ev-cizgi {
    position: absolute;
    bottom: 6px;
    left: 50%;
    margin-left: -60px;
    width: 120px;
    height: 5px;
    border-radius: 2.5px;
    background-color: rgba(255, 240, 222, 0.45);
}

/* Yazıcı ile yazılan içerik: telefonun yazı boyları */
.tel .yz-satir { margin-bottom: 2px; }
.tel .yz-metin { font-size: 13px; color: var(--yazi); }
.tel .yz-metin.tel-dev { font-size: 26px; -unity-font-style: bold; color: var(--yazi); }
.tel .yz-metin.tel-dev24 { font-size: 24px; -unity-font-style: bold; color: var(--yazi); }
.tel .yz-metin.tel-buyuk { font-size: 22px; -unity-font-style: bold; }
.tel .yz-metin.tel-baslik { font-size: 18px; -unity-font-style: bold; color: var(--yazi); margin-top: 2px; }
.tel .yz-metin.tel-soluk { font-size: 12px; color: var(--soluk); }
.tel .yz-metin.tel-kucuk { font-size: 10px; -unity-font-style: bold; color: var(--soluk); letter-spacing: 0.5px; }
.tel .yz-metin.tel-vurgu { font-size: 14px; -unity-font-style: bold; }
.tel .yz-metin.tel-satir { font-size: 15px; }
.tel .yz-metin.tel-deger { font-size: 16px; }
.tel .yz-metin.tel-kalin14 { font-size: 14px; -unity-font-style: bold; }
.tel .yz-metin.tel-italik { -unity-font-style: italic; }
.tel-orta { -unity-text-align: upper-center; }
.tel-soluk-yazi { font-size: 12px; color: var(--soluk); }
.tel-govde-yazi { font-size: 13px; color: var(--yazi); }
.tel-satir-yazi { font-size: 15px; color: var(--yazi); }
.tel .yz-kv { min-height: 36px; border-bottom-width: 1px; border-color: rgba(255, 240, 222, 0.08); margin-bottom: 0; }
.tel .yz-kv-ad { font-size: 15px; color: var(--yazi); }
.tel .yz-kv-deger { font-size: 15px; color: var(--soluk); }
.tel .yz-kutular { margin: 4px -6px 2px 0; }
.tel .yz-kutu { background-color: var(--kagit-acik); min-width: 90px; }
.tel .yz-kutu-deger { font-size: 16px; color: var(--yazi); }
.tel .kart.tel-kart {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1.5px;
    border-color: var(--kenar);
    border-radius: 12px;
    padding: 8px 10px 8px 10px;
    margin: 0 0 8px 0;
}
.tel-cizgi { height: 1px; background-color: rgba(255, 240, 222, 0.08); margin: 6px 0 6px 0; flex-shrink: 0; }
.tel-sheet .tel-cizgi { margin-left: -18px; margin-right: -18px; }
.tel .kart.tel-kart .tel-cizgi { margin-left: 0; margin-right: 0; }

/* Telefon düğmeleri (renkleri koddan) */
.tel Button.dg.tel-dg { height: 44px; border-radius: 22px; font-size: 15px; margin: 2px 0 6px 0; }
.tel Button.dg.tel-dg.tel-dg-buyuk { height: 48px; border-radius: 24px; }
.tel Button.dg.tel-dg.tel-dg-orta { height: 40px; border-radius: 20px; font-size: 14px; }
.tel Button.dg.tel-dg.tel-dg-kucuk { height: 38px; border-radius: 19px; font-size: 13px; }
.tel .yz-dugmeler > Button.dg.tel-dg { margin: 0 6px 6px 0; }
.tel Button.dg.genis { flex-basis: 0; }
.tel Button.dg.tel-baglanti { height: 36px; font-size: 15px; margin: 0; border-width: 0; }
.tel Button.dg.tel-baglanti.tel-baglanti-sol { -unity-text-align: middle-left; padding-left: 0; align-self: flex-start; font-size: 14px; }
.tel .yz-dugmeler > Button.dg.tel-baglanti.tel-baglanti-satir { height: 40px; font-size: 14px; margin: 0 0 6px 4px; }

/* Parçalar (Arayuz/UiTelefonParcalar.cs) */
.tel-hap { flex-direction: row; align-items: center; height: 56px; border-radius: 28px; margin: 2px 0 4px 0; flex-shrink: 0; border-width: 2px; border-color: var(--cerceve); }
.tel-durum-hap { height: 54px; border-radius: 27px; margin: 0 14px 22px 14px; }
.tel-hap-daire {
    position: absolute;
    left: 5px;
    top: 5px;
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: var(--cerceve);
    align-items: center;
    justify-content: center;
}
.tel-durum-hap .tel-hap-daire { width: 44px; height: 44px; border-radius: 22px; }
.tel-hap-yazi {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(20, 18, 16);
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tel-boost {
    flex-direction: row;
    align-items: center;
    height: 44px;
    border-radius: 12px;
    background-color: var(--kart);
    overflow: hidden;
    padding-right: 10px;
    border-width: 1.5px;
    border-color: var(--kenar);
}
.tel-boost:hover { background-color: var(--kart-ust); }
.tel-boost-sol { width: 52px; height: 100%; align-items: center; justify-content: center; border-radius: 12px; }
.tel-boost-yuzde { font-size: 14px; color: rgb(255, 255, 255); }
.tel-boost-yazi {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
    font-size: 13px;
    color: var(--yazi);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.tel-boost-buyuk { flex-direction: row; height: 76px; border-radius: 12px; overflow: hidden; margin: 4px 0 4px 0; border-width: 1.5px; border-color: var(--kenar); }
.tel-boost-buyuk-sol { width: 70px; height: 100%; border-radius: 12px; align-items: center; justify-content: center; }
.tel-boost-buyuk-yuzde { font-size: 22px; color: rgb(255, 255, 255); }
.tel-boost-buyuk-ic { margin-left: 14px; justify-content: center; }
.tel-boost-buyuk-deger { font-size: 20px; color: var(--yazi); }
.tel-segment { flex-direction: row; height: 36px; border-radius: 10px; background-color: var(--cukur); padding: 3px; border-width: 1.5px; border-color: var(--kenar); }
.tel-segment-oge {
    flex-grow: 1;
    flex-basis: 0;
    border-radius: 8px;
    font-size: 12px;
    color: var(--yazi);
    -unity-text-align: middle-center;
    margin: 0 1px 0 1px;
}
.tel-segment-oge:hover { background-color: rgba(255, 240, 222, 0.06); }
.tel-segment-oge.secili { background-color: var(--yazi); color: var(--zemin); }
.tel-yogunluk { flex-direction: row; align-items: center; margin: 2px 0 2px 0; }
.tel-yogunluk-cubuklar { flex-direction: row; align-items: flex-end; height: 14px; margin: 0 6px 0 8px; }
.tel-yogunluk-cubuk { width: 4px; margin-right: 2px; border-radius: 1px; }
.tel-gosterge { align-items: center; margin: 4px 0 4px 0; }
.tel-gosterge-halka { width: 110px; height: 110px; align-items: center; justify-content: center; }
.tel-gosterge-yuzde { font-size: 26px; color: var(--yazi); }
.tel-zaman { flex-direction: row; align-items: center; min-height: 26px; margin-bottom: 4px; }
.tel-zaman-saat { width: 46px; font-size: 14px; color: var(--yazi); flex-shrink: 0; white-space: nowrap; }
.tel-zaman-nokta {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 2px;
    margin: 0 9px 0 3px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.tel-zaman-isaret { font-size: 9px; color: rgb(0, 0, 0); -unity-text-align: middle-center; }
.tel-zaman-yazi { flex-grow: 1; flex-shrink: 1; font-size: 14px; color: var(--yazi); }
.tel-uyari {
    flex-direction: row;
    align-items: flex-start;
    border-radius: 10px;
    background-color: rgb(64, 40, 20);
    padding: 10px 10px 12px 12px;
    margin: 2px 0 6px 0;
    border-width: 1.5px;
    border-color: var(--uyari);
}
.tel-uyari-simge { margin: 1px 10px 0 0; }
.tel-uyari-bas { font-size: 11px; color: var(--uyari); letter-spacing: 0.4px; }
.tel-uyari-metin { font-size: 12px; color: var(--yazi); margin-top: 3px; }
.tel-iki { flex-direction: row; align-items: center; min-height: 22px; }
.tel-etiket {
    height: 20px;
    border-radius: 10px;
    padding: 0 7px 0 7px;
    font-size: 10px;
    -unity-text-align: middle-center;
    margin-left: 6px;
    flex-shrink: 0;
    white-space: nowrap;
}
.tel-menu-satir {
    flex-direction: row;
    align-items: center;
    height: 54px;
    border-bottom-width: 1px;
    border-color: rgba(255, 240, 222, 0.08);
    padding-right: 4px;
}
.tel-menu-satir:hover { background-color: rgba(255, 240, 222, 0.03); }
.tel-menu-harf-kutu {
    width: 28px;
    height: 28px;
    margin: 0 22px 0 4px;
    border-radius: 8px;
    border-width: 1.5px;
    border-color: var(--cerceve);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.tel-menu-satir.simgeli .tel-menu-harf-kutu { border-width: 0; }
.tel-menu-harf { font-size: 12px; color: var(--yazi); -unity-text-align: middle-center; }
.tel-profil { flex-direction: row; align-items: center; height: 62px; border-bottom-width: 1px; border-color: rgba(255, 240, 222, 0.08); }
.tel-profil:hover { background-color: rgba(255, 240, 222, 0.03); }
.tel-avatar { width: 42px; height: 42px; border-radius: 21px; font-size: 18px; -unity-text-align: middle-center; margin-right: 12px; flex-shrink: 0; }
.tel-konu { flex-direction: row; align-items: center; height: 50px; border-bottom-width: 1px; border-color: rgba(255, 240, 222, 0.08); }
.tel-konu:hover { background-color: rgba(255, 240, 222, 0.03); }
.tel-hedef { margin-bottom: 8px; }
.tel-hedef-iz { height: 8px; border-radius: 4px; background-color: var(--cukur); margin-top: 3px; overflow: hidden; border-width: 1px; border-color: rgba(255, 240, 222, 0.25); }
.tel-hedef-dolu { height: 100%; border-radius: 4px; min-width: 8px; }
.tel-buyuk-sayi { height: 90px; border-radius: 14px; flex-direction: row; margin: 4px 0 2px 0; border-width: 2px; border-color: var(--cerceve); }
.tel-buyuk-sayi-ic { width: 62%; align-items: center; justify-content: center; }
.tel-buyuk-sayi-deger { font-size: 34px; color: rgb(8, 10, 15); }
.tel-buyuk-sayi-yazi { font-size: 13px; color: rgb(8, 10, 15); margin-top: 2px; }
.tel-canta { position: absolute; right: 22px; top: 14px; width: 70px; height: 64px; border-radius: 10px; background-color: rgba(255, 255, 255, 0.55); }
.tel-canta-sap { position: absolute; left: 12px; top: -8px; width: 46px; height: 14px; border-radius: 7px; background-color: rgba(255, 255, 255, 0.35); }
.tel-sigorta {
    height: 130px;
    border-radius: 10px;
    background-color: var(--kart);
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 16px;
    border-width: 1.5px;
    border-color: var(--kenar);
}
.tel-pano { width: 76px; height: 96px; border-radius: 8px; background-color: rgb(242, 128, 51); padding: 6px; margin-right: -14px; border-width: 1.5px; border-color: var(--cerceve); }
.tel-pano-kagit { flex-grow: 1; border-radius: 5px; background-color: rgb(255, 255, 255); padding: 10px 8px 0 8px; }
.tel-pano-yuvarlak { width: 20px; height: 20px; border-radius: 10px; background-color: rgb(77, 179, 242); margin-bottom: 8px; }
.tel-pano-satir { height: 4px; border-radius: 2px; background-color: rgb(217, 219, 230); margin-bottom: 6px; }
.tel-kalkan {
    width: 54px;
    height: 62px;
    border-radius: 22px;
    background-color: rgb(255, 209, 77);
    align-items: center;
    justify-content: center;
    margin-bottom: -4px;
    border-width: 1.5px;
    border-color: var(--cerceve);
}
.tel-kalkan-daire {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
}
.tel-kalkan-isaret { font-size: 13px; color: rgb(77, 179, 242); -unity-text-align: middle-center; }
.tel-topla-alt { margin-top: 2px; }
.tel-topla-hap { height: 44px; border-radius: 22px; font-size: 15px; color: rgb(10, 13, 20); -unity-text-align: middle-center; margin-right: 6px; border-width: 2px; border-color: var(--cerceve); }
.tel-topla-ok {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: rgb(54, 49, 45);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.tel-topla-ok:hover { background-color: rgb(70, 63, 58); }

/* ---------------------------------------------------------------- bina kartı (Arayuz/UiBinaKarti.cs) */

.bina-kart {
    position: absolute;
    background-color: var(--zemin);
    border-radius: 16px;
    border-width: 2px;
    border-color: var(--cerceve);
    border-bottom-width: 3px;
    overflow: hidden;
}
.bina-ust { flex-direction: row; align-items: center; padding: 12px 10px 10px 14px; flex-shrink: 0; }
.bina-simge-kutu { width: 40px; height: 40px; border-radius: 12px; align-items: center; justify-content: center; flex-shrink: 0; border-width: 1.5px; border-color: var(--cerceve); }
.bina-ad { font-size: 17px; }
.bina-kart > .pencere-cizgi { margin: 0 12px 0 12px; flex-shrink: 0; }
.bina-govde { flex-grow: 0; flex-shrink: 0; min-height: 40px; padding: 8px 4px 10px 12px; }   /* yüksekliği koddan (KaydirmaYuksekligi) */
.bina-kart .yz-kutular { flex-wrap: nowrap; }   /* satırlar koddan 2'şerli (Yazici.KutuSutun): sarılan satır üst üste biniyordu */
.bina-kart .yz-kutu { min-width: 120px; }

/* ---------------------------------------------------------------- büyük kurye kartı (Arayuz/UiBuyukKart.cs) */

.bk-kart { padding: 16px 20px 16px 20px; }
.bk-govde { flex-grow: 0; flex-shrink: 0; min-height: 60px; }   /* yüksekliği koddan (KaydirmaYuksekligi) */
.bk-bas { align-items: flex-start; margin-bottom: 12px; }
.portre.bk-portre { width: 96px; height: 96px; border-radius: 16px; }
.yildiz.bk-seviye { font-size: 12px; height: 20px; border-radius: 10px; padding: 0 7px 0 7px; }
.bk-kimlik { margin-left: 14px; }
.bk-ad { font-size: 20px; }
.bk-arac {
    flex-direction: row;
    align-items: center;
    height: 24px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: var(--kenar);
    padding: 0 10px 0 8px;
    background-color: rgba(255, 240, 222, 0.07);
    margin-left: 8px;
    flex-shrink: 0;
}
.bk-satir { flex-direction: row; margin: 0 -6px 6px -6px; }
.kart.bk-kutu { flex-grow: 1; flex-basis: 0; margin: 0 6px 6px 6px; }
.yz-metin.bk-baslik { font-size: 11px; color: var(--etiket); letter-spacing: 0.9px; -unity-font-style: bold; margin-bottom: 5px; }
.bk-beceri { flex-direction: row; align-items: center; min-height: 22px; }
.bk-dugmeler { margin-top: 12px; flex-shrink: 0; }
